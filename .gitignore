
# Environment files
.env
.env.*

# Dependencies
vendor/
node_modules/

# Writable directories (keep the folders but ignore contents)
writable/cache/*
!writable/cache/.gitkeep
writable/logs/*
!writable/logs/.gitkeep
writable/session/*
!writable/session/.gitkeep
writable/uploads/*
!writable/uploads/.gitkeep
writable/debugbar/*
!writable/debugbar/.gitkeep

# OS generated files
.DS_Store
Thumbs.db

# User specific ignored files
app/Config/App.php
